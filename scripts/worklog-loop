#!/bin/bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
worklog=${1:-}
am_phases=7

usage() {
  echo "Usage: worklog-loop <worklog> [am-phases] [-- <runner> [args...]]" >&2
  echo >&2
  echo "The runner receives the generated prompt as its final argument." >&2
  echo "Without a runner, clai is called with the bundled profile." >&2
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ -z "$worklog" ]]; then
  usage
  exit 1
fi

shift
if [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]; then
  am_phases=$1
  shift
fi

runner=(clai -profile-path "$script_dir/clai-agent-profile-worklog-loop.json" q)
if [[ "${1:-}" == "--" ]]; then
  shift
  if [[ $# -eq 0 ]]; then
    echo "Error: runner command is missing after --" >&2
    exit 1
  fi
  runner=("$@")
elif [[ $# -gt 0 ]]; then
  echo "Error: unexpected argument: $1 (use -- before a runner command)" >&2
  usage
  exit 1
fi

if [[ ! -r "$worklog" ]]; then
  echo "Error: worklog is not a readable file: $worklog" >&2
  exit 1
fi

if [[ ! "$am_phases" =~ ^[1-9][0-9]*$ ]]; then
  echo "Error: am-phases must be a positive integer: $am_phases" >&2
  exit 1
fi

go run github.com/baalimago/repeater@latest -n "$am_phases" -w 1 -output STDOUT "${runner[@]}" "Please implement one phase of this worklog. This work has multiple phases; complete only the next eligible phase during this session.

Runbook:
1. Read $worklog. If its line is done, waiting on human, or stopped only by andons owned by the maintainer, report why and end the session.
2. If a phase is Reopened, or any finding owned by fix is open or regressed, run the worklog-fix skill instead and end the session.
3. If every phase is Complete, review the root with the worklog-review skill instead and end the session.
4. Otherwise run the worklog-work skill: select the phase, run every gate, do that one phase, run every gate again.
5. Read only what the worklog-work reading contract allows, plus the repository guidance it points to.

Guidelines:
* Follow the strict guidelines in your prompt and in AGENTS.md.
* Change only what the selected phase requires. Keep it lean and clean: no bloat, dead code, or redundancy.
* Never change a signed-off interface. If the phase needs one changed, stop the line as worklog-work describes.
* Record gate runs and surprises in the phase's implementation notes, in the shape worklog-work defines."
